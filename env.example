# Copy this file to .env (or export these as real environment variables) and adjust as needed.
# The application also runs fine with zero config, using the defaults baked into application.yml —
# these are here for production-style overrides.

# ---- Server ----
SERVER_PORT=8080

# ---- Database (PostgreSQL is the default; see application-mysql.yml for MySQL) ----
DB_URL=jdbc:postgresql://localhost:5432/resource_booking
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DRIVER=org.postgresql.Driver
DDL_AUTO=update
SHOW_SQL=false

# ---- JWT ----
# IMPORTANT: generate your own Base64-encoded 256-bit+ secret for real deployments, e.g.:
#   openssl rand -base64 32
JWT_SECRET=MzhmNGI3N2M5ZDJlNDFhNGI4ZjkyM2E3ZDYxYzhlMmY5YjA3ZDNlNGE1YzZmN2E4YjljMGQxZTJmM2E0YjVjNmQ3ZTg=
JWT_EXPIRATION_MS=86400000

# ---- Seed data (created on first startup if not already present) ----
SEED_ENABLED=true
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@123
SEED_ADMIN_EMAIL=admin@bookingsystem.com
SEED_USER_USERNAME=john
SEED_USER_PASSWORD=User@123
SEED_USER_EMAIL=john@bookingsystem.com

# ---- Logging ----
LOG_LEVEL=INFO
SECURITY_LOG_LEVEL=WARN
